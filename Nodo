package diagramador;

import java.awt.Point;
import java.awt.Rectangle;

public class Nodo {

    private static int contador = 0;
    private final int id;
    private TipoNodo tipo;
    private String texto;
    private int x;
    private int y;
    private int ancho;
    private int alto;

    private volatile boolean resaltado = false;

    public Nodo(TipoNodo tipo, int x, int y) {
        this.id = ++contador;
        this.tipo = tipo;
        this.x = x;
        this.y = y;
        this.ancho = (tipo == TipoNodo.DECISION) ? 120 : 110;
        this.alto = (tipo == TipoNodo.DECISION) ? 90 : 55;
        this.texto = tipo.name();
    }

    public int getId() {
        return id;
    }

    public TipoNodo getTipo() {
        return tipo;
    }

    public String getTexto() {
        return texto;
    }

    public void setTexto(String texto) {
        this.texto = texto;
    }

    public int getX() {
        return x;
    }

    public int getY() {
        return y;
    }

    public int getAncho() {
        return ancho;
    }

    public int getAlto() {
        return alto;
    }

    public boolean isResaltado() {
        return resaltado;
    }

    public void setResaltado(boolean resaltado) {
        this.resaltado = resaltado;
    }

    public void moverA(int nuevoX, int nuevoY) {
        this.x = nuevoX;
        this.y = nuevoY;
    }

    public Point getCentro() {
        return new Point(x + ancho / 2, y + alto / 2);
    }

    public Rectangle getBounds() {
        return new Rectangle(x, y, ancho, alto);
    }

    public boolean contienePunto(int px, int py) {
        return getBounds().contains(px, py);
    }

    @Override
    public String toString() {
        return tipo + "(" + id + ")";
    }
}
